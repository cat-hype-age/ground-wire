name: "ground-wire"
version: "1.1.0"
competition: "grounded-reasoning"
agent:
  type: "harness"
  harness_name: "opencode"
  model: "openrouter/minimax/minimax-m2.5"
  prompt_template_path: "prompts/officeqa_chosen_identity.j2"
  mcp_servers:
    - name: corpus-index
      transport: stdio
      command: python3
      args: ["mcp/corpus_index_server.py"]
  config:
    reasoning_effort: "high"
  env:
    OPENROUTER_API_KEY: "${oc.env:OPENROUTER_API_KEY,''}"
environment:
  timeout_per_task: 600
