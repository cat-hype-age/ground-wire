name: "ground-wire"
version: "1.1.0"
competition: "grounded-reasoning"
agent:
  type: "harness"
  harness_name: "openhands-sdk"
  model: "openrouter/deepseek/deepseek-v3.2"
  skills_dir: "skills/"
  config:
    reasoning_effort: "high"
  env:
    LLM_API_KEY: "${oc.env:OPENROUTER_API_KEY,''}"
